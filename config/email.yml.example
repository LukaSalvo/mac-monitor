# Configuration Email & Discord
# IMPORTANT: Copier ce fichier vers email.yml et remplir avec vos vraies credentials

smtp:
  address: smtp.gmail.com
  port: 587
  domain: gmail.com
  user_name: votre.email@gmail.com
  password: YOUR_GMAIL_APP_PASSWORD_HERE
  authentication: login
  enable_starttls_auto: true

notifications:
  from: "Mac Monitor Alerts <votre.email@gmail.com>"
  to: votre.email@gmail.com
  enabled: false # Désactivé par défaut pour les collègues (Discord uniquement)

discord:
  webhook_url: https://discord.com/api/webhooks/1466533125101195487/GC7ftIfZVrxEqLjburFOGfrG6MaJt8cNMDTxRZ9ZweHaJz7uJZHj4iiMn8C4ZWT_k_Ec
  enabled: true
  username: "Mac Monitor"
  avatar_url: ""
